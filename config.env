# =============================================================================
# config.env  —  central configuration for the student VM build
# =============================================================================
# Edit the values marked "CHANGE ME" before running ./provision.sh.
# Everything below is sourced by the scripts in scripts/. Keep it valid bash.
# =============================================================================

# ---- Identity / groups ------------------------------------------------------
# POSIX group that grants SSH + shell access. All student accounts join it.
# Admins keep sudo via a separate group.
STUDENT_GROUP="students"
ADMIN_GROUP="sudo"

# ---- System / maintenance ---------------------------------------------------
# System timezone. "local time" for the nightly reboot (below) is THIS zone
TIMEZONE="Australia/Sydney"
# Nightly unattended reboot (applies kernel/security updates + resets state).
# HH:MM in TIMEZONE; "" disables. Kicks anyone still connected at that hour.
AUTO_REBOOT_TIME="04:00"

# ---- Swap file (scripts/00-base.sh) -----------------------------------------
# Ubuntu server/cloud images ship with NO swap. With ~20 sessions on one box,
# a swapfile gives the kernel somewhere to push cold pages (idle shells, editors,
# a finished build's heap) instead of evicting page cache or OOM-killing someone
# mid-compile. It is NOT extra RAM — CG_MEMORY_MAX below is still the real
# ceiling per student, and CG_MEMORY_SWAP_MAX caps how much of this file any one
# of them can occupy.
# Set SWAP_SIZE="" to remove the managed swapfile again (swapoff + fstab + file).
SWAP_SIZE="10G"
SWAP_FILE="/swapfile"
# Ubuntu's installer creates its own swapfile (/swap.img). "yes" takes any such
# redundant FILE-backed swap over once ours is live — swapoff, drop its fstab
# line, delete it — so the box has exactly one swapfile of exactly SWAP_SIZE
# rather than both stacked. Swap PARTITIONS and zram are never touched. Set to
# "no" if you deliberately run more than one swap area. This one is not
# reversible: clearing SWAP_SIZE later removes our file, not the installer's.
SWAP_REPLACE_EXISTING="yes"

# ---- Local student accounts (CSV roster) ------------------------------------
# scripts/10-users.sh RECONCILES local accounts against a CSV roster: it adds
# students new to the CSV, re-enables any who reappear, and disables (or
# deletes) accounts that were dropped from it. Existing active accounts (and
# their passwords) are left alone. The "managed set" is the members of
# STUDENT_GROUP, so admin/system accounts are never touched.
STUDENT_ROSTER_CSV="/opt/cst-vm/students.csv"
STUDENT_SHELL="/bin/bash"

# What to do with an account in STUDENT_GROUP that is no longer in the CSV:
#   "disable" — expire the account + set a nologin shell, KEEP the home dir.
#               Safe and reversible: re-adding them to the CSV restores access.
#   "delete"  — userdel -r: REMOVE the account AND its home dir (destructive).
REMOVED_ACCOUNT_ACTION="disable"

# Random password generation (used only for CSV rows with a BLANK password).
PW_LENGTH="10"                # characters per generated password
# Force a student to set a new password at first login? "yes" expires the
# initial password immediately (chage -d 0). Requires SSH_PASSWORD_AUTH=yes.
FORCE_PW_CHANGE="yes"

# Where generated passwords (blank-password rows only) are written for the admin
# to hand out. Root-only (0600). Distribute over a secure channel, then delete.
CREDENTIALS_FILE="/opt/cst-vm/student-credentials.txt"

# ---- Per-user resource limits (cgroups v2 via systemd) ----------------------
# Applied to EVERY user login slice (see scripts/20-cgroups.sh for how admins
# can be exempted). Sized for ~20 concurrent students sharing one VM.
CG_CPU_QUOTA="200%"      # max 2 full cores of CPU time per user
CG_CPU_WEIGHT="100"      # relative share under contention (default 100)
CG_MEMORY_HIGH="2G"      # soft cap: kernel throttles/reclaims above this
CG_MEMORY_MAX="3G"       # hard cap: OOM-kill the user's procs above this
# Max swap per user. Without this, MemoryMax only bounds RESIDENT memory and one
# student could push the whole SWAP_SIZE file out from under everyone else.
# "infinity" uncaps; "0" forbids a student's pages from being swapped at all.
CG_MEMORY_SWAP_MAX="1G"
CG_TASKS_MAX="512"       # max processes/threads per user
CG_IO_WEIGHT="100"       # relative block-IO share under contention

# ulimits (complement to cgroups; enforced by PAM at login)
ULIMIT_NOFILE="4096"     # open file descriptors
ULIMIT_NPROC="512"       # processes (keep <= CG_TASKS_MAX)

# ---- Toolchain versions -----------------------------------------------------
# Installed system-wide from official upstream tarballs (not distro packages),
# so versions are predictable and current regardless of the apt archive.
GO_VERSION="1.23.5"          # https://go.dev/dl/
NODE_VERSION="22.14.0"       # current LTS line; https://nodejs.org/dist/
NVIM_VERSION="0.10.4"        # https://github.com/neovim/neovim/releases
# Python3 comes from the distro (python3 + venv + pip + build tools).

# ---- Pre-installed packages (scripts/35-packages.sh) ------------------------
# Common libraries/tools installed for ALL students, so courses (incl. boot.dev)
# work out of the box without each student installing anything. Students have no
# sudo, so this is the only place system-wide packages get added.

# Python libraries via APT -> land in system site-packages, importable by the
# system `python3` with a plain `import` (no venv needed). Ubuntu's Python is
# PEP-668 "externally managed", so students' OWN extra deps go in a venv; these
# cover the common teaching/data/boot.dev libs. One-per-line; missing names are
# skipped with a warning rather than aborting the run.
APT_PYTHON_PACKAGES="
  python3-numpy python3-pandas python3-matplotlib python3-scipy python3-sympy
  python3-requests python3-flask python3-pytest python3-pil python3-bs4
  python3-sklearn python3-seaborn python3-ipython python3-flake8
  python3-openpyxl black
"

# Node.js GLOBAL CLI tools (system prefix /opt/node, on PATH for everyone).
# NOTE: Node *libraries* (express/react/lodash/…) are NOT pre-installable this
# way — Node resolves them per-project from a local node_modules, so students
# install those with `npm install` in their project. Only CLIs belong here.
NPM_GLOBAL_PACKAGES="typescript ts-node eslint prettier nodemon http-server vite"

# General dev utilities via APT (SQL, the boot.dev C course, HTTP work, etc.).
APT_DEV_UTILS="cowsay sqlite3 valgrind gdb cmake clang httpie"

# Go dev tools installed system-wide into /usr/local/bin (on PATH for all).
# Used across boot.dev's Go / SQL / backend courses; the bootdev CLI runs
# assignment tests locally. Bump @version to pin; @latest tracks upstream.
GO_TOOLS=(
  "github.com/bootdotdev/bootdev@latest"                 # boot.dev CLI (local test runner)
  "github.com/pressly/goose/v3/cmd/goose@latest"         # DB migrations (SQL/backend courses)
  "github.com/sqlc-dev/sqlc/cmd/sqlc@latest"             # SQL -> typed Go (backend courses)
)

# ---- SSH --------------------------------------------------------------------
SSH_PORT="22"
# Space-separated groups allowed to SSH in. Students + admins.
SSH_ALLOW_GROUPS="${STUDENT_GROUP} ${ADMIN_GROUP}"
# Set to "no" to force key-only auth (recommended once students have uploaded
# keys). "yes" lets students log in with their (random) passwords — required
# for the first-login password change to work.
SSH_PASSWORD_AUTH="yes"
# IPs/CIDRs fail2ban must never ban (space-separated). Put any admin jump host
# here so admin SSH sessions can't get locked out.
FAIL2BAN_IGNORE_IPS=""

# =============================================================================
# Host firewall — ufw (scripts/46-firewall.sh)
# =============================================================================
# Two halves:
#
#   INBOUND   default deny. Only FW_ALLOW_INBOUND_TCP is opened (SSH + the
#             dev-server range the MOTD tells students to bind), and only FROM
#             the admin/peer subnets listed in FW_ALLOW_INBOUND_FROM.
#
#   OUTBOUND  default allow, so the box reaches the INTERNET normally — but the
#             whole of RFC1918 10.0.0.0/8 is blocked. Everything in
#             FW_ISOLATE_SUBNETS is refused except the hosts in
#             FW_SUBNET_ALLOW_HOSTS (the gateway, and any on-net service the box
#             depends on). ~20 students with a shell, a compiler and nmap sit on
#             this LAN; this keeps them from reaching ANY internal network from
#             the box, while leaving internet-bound traffic (public destination
#             IPs, which never match the 10/8 rule) completely untouched.
#
# What this does NOT block: connections made TO this box from an allowed
# inbound subnet. Their reply packets are established traffic, which ufw accepts
# ahead of these rules — so an admin on one of the FW_ALLOW_INBOUND_FROM subnets
# can still SSH in, and a peer there can still reach a student's dev server,
# even though the box itself may not initiate traffic back into 10.0.0.0/8.
ENABLE_FIREWALL="yes"

# Block IPv6 outright. Two layers, because either alone is a half-measure:
#   * the stack is turned off (net.ipv6.conf.*.disable_ipv6=1), so interfaces
#     hold no v6 address at all;
#   * ufw is told to DROP all outbound v6, so if anything ever turns the stack
#     back on the box still can't use it.
# Worth doing even though the rules below are IPv4: IPv6 link-local addressing
# needs no router and no DHCP, so a student could otherwise reach every
# neighbour on the segment over v6 and walk straight around the block.
# "no" removes both layers (and re-enables the stack live).
FW_BLOCK_IPV6="yes"

# Subnets the box may not talk to on its own initiative. Space-separated CIDRs
# (an IPv6 prefix works too, though with FW_BLOCK_IPV6="yes" v6 is already gone).
# Blocks the whole RFC1918 10.0.0.0/8 range: the box is isolated from every
# internal network and can only reach the internet (public destinations) plus
# the explicit exceptions in FW_SUBNET_ALLOW_HOSTS below. This also covers "lock
# down outbound to the local segment" — that segment is inside 10/8.
FW_ISOLATE_SUBNETS="10.0.0.0/8"

# Exceptions inside those subnets — on-net hosts the box still needs. The
# default gateway MUST be here or the box has no route to anything (with all of
# 10/8 now blocked this is essential — update it if the gateway isn't 10.90.196.1).
# Anything else in 10/8 the box depends on belongs here too: a local DNS resolver,
# an NTP server, an APT mirror or proxy, a Sophos update relay. Stage 46 refuses
# to run if the gateway is missing and warns if a resolver is.
FW_SUBNET_ALLOW_HOSTS="10.90.196.1"

# How blocked on-subnet traffic is refused.
#   "reject" — answer immediately, so a mistyped address fails in a second
#              instead of hanging for two minutes. Easier to support.
#   "deny"   — drop silently: slower to port-scan through, worse to debug.
FW_ISOLATE_ACTION="reject"

# Log what the isolation rules block? Useful when something on-segment stops
# working and you need to see what it was reaching for. ufw rate-limits the log
# (3/min, burst 10) so a student's retry loop can't flood the journal — but for
# the same reason it's a sample, not a full record. Off by default because the
# expected steady state here is "students probe the subnet and get refused",
# which is noise, not news. Read it with: journalctl -k | grep '\[UFW'
FW_LOG_ISOLATED="no"

# ufw's own log level: off | low | medium | high | full.
FW_LOGGING="low"

# TCP ports open to the network: SSH, plus the dev-server range (ufw wants a
# colon, not the dash MOTD_DEV_PORTS uses — stage 46 warns if the two drift).
FW_ALLOW_INBOUND_TCP="${SSH_PORT} 3000:3999"

# Restrict WHO may reach those ports — space-separated IPs/CIDRs; "" = anywhere.
# Locked to the admin/peer subnets that are allowed to reach SSH and the
# dev-server range; every other source (including the rest of 10/8) is denied
# inbound by the default-deny policy. Reply traffic to these connections is
# established/related, so it flows back even though the box may not initiate
# outbound into 10/8.
FW_ALLOW_INBOUND_FROM="10.24.4.0/24 10.24.16.0/24 10.24.99.0/24 10.1.99.0/24 10.16.99.0/24 10.8.99.0/24"

# =============================================================================
# Lockdown / hardening (scripts/45-hardening.sh)
# =============================================================================
# A shared box gives ~20 students a shell + compilers + network. You can't stop
# them running code; these controls stop persistent servers, close inbound,
# isolate students from each other, and cap the shared disk. EVERY line below is
# a lever — set "no" (or change the value) to loosen a given restriction.

# Kill all of a user's processes when their last session ends. THE anti-"24/7
# Minecraft server" control: nothing a student launches survives logout.
# Tradeoff: detached tmux/screen and long background jobs die on disconnect too.
HARDENING_KILL_USER_PROCESSES="yes"
# Users exempt from the kill-on-logout (space-separated) — e.g. admins who want
# tmux to persist. NEVER list students here. Add your admin account(s) as needed.
HARDENING_KILL_EXCLUDE_USERS="root administrator"

# Deny non-admins the ability to enable systemd "linger" (which would let a unit
# run at boot / persist with no login) — closes the loophole around the setting
# above. Admins (ADMIN_GROUP) keep it.
HARDENING_DISABLE_LINGER="yes"

# Restrict cron and at to admins (root + ADMIN_GROUP). Stops students scheduling
# a relaunch of a killed server/bot.
HARDENING_RESTRICT_CRON="yes"

# Auto-log-out an idle student shell after this many seconds (bash TMOUT), which
# then triggers kill-on-logout and frees their slice. Admins (ADMIN_GROUP) are
# exempt. Seconds; "0" or "" disables. Note: only counts idleness AT THE PROMPT —
# a foreground program (editor, a running dev server, a long compile) is "busy",
# so genuine work isn't interrupted.
HARDENING_IDLE_TIMEOUT="3600"     # 30 minutes

# Kernel sysctl hardening (dmesg/kptr restrict, no unprivileged BPF, perf
# paranoia, ptrace scope).
HARDENING_SYSCTL="yes"
# Restrict unprivileged user namespaces so students can't run a rootless
# container runtime they brought themselves (reinforces "no containers").
HARDENING_RESTRICT_USERNS="yes"

# hidepid on /proc: students can't see each other's processes / command lines
# (which leak secrets passed as args). ADMIN_GROUP keeps full visibility.
HARDENING_HIDEPID="yes"

# Private home dirs + restrictive default umask, so students can't read each
# other's files (privacy / anti-cheating). Applies to new AND existing homes.
HARDENING_HOME_MODE="0700"
HARDENING_UMASK="077"

# Restrict FUSE (fusermount) to admins, so students can't sshfs/rclone-mount a
# remote host into their home to exfiltrate or bypass egress.
HARDENING_RESTRICT_FUSE="yes"

# Mount hardening for /tmp and /dev/shm. nosuid+nodev always; noexec on /dev/shm
# is safe; noexec on /tmp is OFF by default because it breaks build tools that
# compile there (pip wheels, node-gyp). The size cap stops a /tmp fill DoS.
HARDENING_HARDEN_TMP="yes"
HARDENING_TMP_SIZE="2G"
HARDENING_TMP_NOEXEC="no"

# ---- Per-user disk quotas ---------------------------------------------------
# Limits each student's home-dir size (cgroups cap CPU/RAM/procs but NOT disk).
# On a stock Ubuntu install /home lives on the root filesystem, so this enables
# usrquota on '/'. First run adds 'usrquota' to /etc/fstab (with a backup) and
# tells you to reboot; after the reboot, re-run stage 45 to apply the limits.
#
# Budget for a 100 GB disk, ~20 students: OS + toolchains + shared packages use
# ~15-20 GB, leaving ~80 GB for homes. 20 × 4 GB hard = 80 GB, so even everyone
# maxed won't fill the disk. Raise if students hit it doing legit work.
ENABLE_HOME_QUOTA="yes"
QUOTA_SOFT="3G"             # soft limit (7-day grace, then enforced like hard)
QUOTA_HARD="4G"            # hard limit (writes fail past this)
# Inode (file-count) limits are a secondary guard against inode-exhaustion (many
# tiny files). 0 = unlimited. Node's node_modules are file-count-heavy, so this
# is generous; lower it only if inode exhaustion becomes a real problem.
QUOTA_INODES_SOFT="0"
QUOTA_INODES_HARD="500000"

# =============================================================================
# Student welcome message (scripts/48-motd.sh)
# =============================================================================
# Shown at every login. Tells students the house rules up front (sessions end on
# logout/idle, no sudo, venv for pip, dev-server ports, quota, back up with git).
MOTD_DEV_PORTS="3000-3999"        # dev-server port range open on the SDN
MOTD_IT_CONTACT="the PARED IT Team"   # who to contact for help / system packages

# =============================================================================
# Sophos endpoint protection (scripts/50-sophos.sh)
# =============================================================================
# Runs the Sophos Central installer IF you drop it next to provision.sh. The
# file is not in this repo — download SophosSetup.sh from your Sophos Central
# account (it embeds your tenant token) and place it at the path below.
SOPHOS_INSTALLER="SophosSetup.sh"       # relative to the build dir (next to provision.sh)
SOPHOS_PRODUCTS="mdr,xdr,antivirus"     # passed as --products=...
